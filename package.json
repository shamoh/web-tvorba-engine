{
  "name": "web-tvorba-engine",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env scripts/preview.mjs",
    "corners": "node --env-file-if-exists=.env scripts/corners.mjs",
    "images": "node --env-file-if-exists=.env scripts/process-images.mjs",
    "check:images": "node --env-file-if-exists=.env scripts/check-images.mjs",
    "check:site": "node --env-file-if-exists=.env scripts/check-site.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "demo:prepare": "node scripts/demo.mjs",
    "demo:images": "node scripts/demo-images.mjs",
    "binary:pull": "node scripts/binary.mjs unpack",
    "demo": "node scripts/demo.mjs && SITE_DIR=.demo/site astro dev",
    "demo:build": "node scripts/demo.mjs && SITE_DIR=.demo/site astro build",
    "straighten": "node scripts/straighten.mjs",
    "favicons": "node --env-file-if-exists=.env scripts/favicons.mjs",
    "app-screenshots": "node scripts/app-screenshots.mjs",
    "game-overview": "node --env-file-if-exists=.env scripts/game-overview.mjs",
    "game-export": "node --env-file-if-exists=.env scripts/game-export.mjs",
    "prototypes": "node --env-file-if-exists=.env scripts/prototypes.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "opentype.js": "2.0.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
