---
// Podmínky užití: what visitors may do with the works, photos and texts of the site (copyright). Texts in
// stranky/podminky-uziti.yaml of the content repository (TERMS_SCHEMA), the defaults without it; linked from the footer.
import Base from '../layouts/Base.astro';
import TextBlocks from '../components/TextBlocks.astro';
import { getTermsPage, site } from '../lib/site';
import { TERMS_PATH } from '../../scripts/lib/pages.mjs';
import { absolute, breadcrumbLd, graphLd } from '../../scripts/lib/seo.mjs';
import { keepTogether } from '../../scripts/lib/typography.mjs';

const page = getTermsPage();
const path = TERMS_PATH;
// For search engines: a web page of the author's site.
const jsonLd = graphLd(
  { '@type': 'WebPage', '@id': absolute(site, path), url: absolute(site, path), name: `${page.title} – ${site.author}`, inLanguage: 'cs' },
  breadcrumbLd(site, [{ name: 'Úvod', path: '/' }, { name: page.title, path }]),
);
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <article class="text-page">
    <h1>{keepTogether(page.title)}</h1>
    <TextBlocks blocks={page.blocks} closing={page.closing} />
    {page.english.blocks.length > 0 && (
      <section class="english" lang="en">
        <h2>{page.english.title}</h2>
        <TextBlocks blocks={page.english.blocks} />
      </section>
    )}
  </article>
</Base>
<style>
  .text-page { max-width: 62ch; font-size: 1.08rem; }
  .text-page h1 { margin: 0 0 32px; }
  .english { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  .english h2 { margin: 0 0 16px; }
</style>
